# PostgreSQL local do Canhoto Digital.
# Copie este arquivo para .env e troque a senha por um valor forte.
# O arquivo .env real é ignorado pelo Git.

CANHOTO_POSTGRES_DB=canhoto_db
CANHOTO_POSTGRES_USER=canhoto_app
CANHOTO_POSTGRES_PASSWORD=troque_por_uma_senha_forte
CANHOTO_POSTGRES_PORT=5433

# Geocoder local (geocodebr/CNEFE), publicado apenas em localhost.
CANHOTO_GEOCODER_PORT=8001
