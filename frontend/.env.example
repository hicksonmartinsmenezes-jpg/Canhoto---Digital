# Conexão do Next.js com o PostgreSQL local.
# Copie para frontend/.env.local e troque todos os valores marcados.
# Nunca versione frontend/.env.local.

DATABASE_URL=postgresql://canhoto_app:troque_por_uma_senha_forte@127.0.0.1:5433/canhoto_db

# Segredos HMAC independentes. Use valores aleatórios longos e diferentes.
ADMIN_SESSION_SECRET=gere_um_segredo_aleatorio_de_64_bytes
MOTORISTA_SESSION_SECRET=gere_outro_segredo_aleatorio_de_64_bytes
COLABORADOR_SESSION_SECRET=troque_por_um_segredo_aleatorio_longo

# Hostname publicado no Cloudflare Tunnel SOMENTE para a área /motorista.
# Quando definido, qualquer outra rota acessada por esse hostname retorna 404.
PUBLIC_MOTORISTA_HOST=entregas.seudominio.com.br

# Bypass opcional apenas em desenvolvimento local. Não use em produção.
DEV_AUTH_BYPASS=false

# Diretório físico para fotos e assinaturas das entregas.
# Em desenvolvimento pode ficar vazio: a aplicação usa <raiz-do-repo>/storage/uploads.
# No servidor dedicado, prefira um caminho absoluto fora do código.
CANHOTO_UPLOAD_DIR=
