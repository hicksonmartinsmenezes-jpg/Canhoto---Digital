# Copie este arquivo para .env.local e preencha com as chaves do seu projeto Supabase
# (Project Settings > API no painel do Supabase).

NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque_a_anon_key_aqui

# URL pública fixa do Portal Admin. Em produção, use a URL HTTPS oficial.
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Service role key (Project Settings > API > "service_role", clique em "Reveal").
# NUNCA exponha esta chave no browser — só é lida em código de servidor
# (src/lib/supabase/admin.ts), usada para tarefas privilegiadas do servidor.
SUPABASE_SERVICE_ROLE_KEY=coloque_a_service_role_key_aqui

# Segredo para assinar o cookie de sessao do app do motorista (login
# por PIN, ver src/lib/motorista-session-core.ts). Gere um valor aleatorio,
# por exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MOTORISTA_SESSION_SECRET=coloque_um_valor_aleatorio_aqui
