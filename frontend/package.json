{
  "name": "frontend",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "npm run clean:next-types && next build",
    "start": "next start -p 3003 -H 0.0.0.0",
    "lint": "eslint",
    "typecheck": "npm run clean:next-types && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "knip": "knip",
    "admin:create": "node scripts/create-admin.mjs",
    "gestor-setor:create": "node scripts/create-gestor-setor.mjs",
    "clean:next-types": "node -e \"require('fs').rmSync('.next/dev/types',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@types/leaflet": "^1.9.22",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.32.0",
    "motion": "^13.1.1",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "knip": "^6.32.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  }
}
