# Number of days to keep complete backup packages.
BACKUP_RETENTION_DAYS=30

# Pasta da cópia EXTERNA (sincronizada pelo Google Drive para computador).
# Com BACKUP_ENCRYPTION_PASSPHRASE definida, cada backup vai para lá como UM
# arquivo canhoto-AAAAMMDD-HHMMSS.zip.enc (criptografado). Sem a senha, o
# pacote vai em pasta, sem criptografia (o script avisa).
#
# Examples:
# BACKUP_MIRROR_DIR=G:\Meu Drive\Canhoto Digital\Backups
# BACKUP_MIRROR_DIR=%OneDrive%\Canhoto Digital\Backups
BACKUP_MIRROR_DIR=

# Senha da criptografia da cópia externa (mínimo 12 caracteres, de preferência
# uma frase longa). GUARDE EM OUTRO LUGAR (gerenciador de senhas ou papel num
# cofre): sem ela, o backup da nuvem não abre — e se o PC for perdido, este
# arquivo vai junto.
BACKUP_ENCRYPTION_PASSPHRASE=

# Alerta no Telegram quando o backup falhar ou terminar com avisos (opcional).
# 1) No Telegram, fale com @BotFather -> /newbot -> copie o token.
# 2) Mande uma mensagem qualquer para o bot e abra
#    https://api.telegram.org/bot<TOKEN>/getUpdates para ver o "chat":{"id":...}.
BACKUP_TELEGRAM_BOT_TOKEN=
BACKUP_TELEGRAM_CHAT_ID=

# Optional upload directory override.
# Leave empty to use <repo>\storage\uploads.
# Use the same location configured as CANHOTO_UPLOAD_DIR for the Next.js app.
CANHOTO_UPLOAD_DIR=

# Optional exported-reports directory override.
# Leave empty to use <repo>\storage\relatorios.
# Use the same location configured as CANHOTO_RELATORIOS_DIR for the Next.js app.
CANHOTO_RELATORIOS_DIR=
